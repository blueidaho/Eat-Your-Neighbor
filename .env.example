# MailerLite — primary email signup list (Integrations > API in MailerLite)
MAILERLITE_API_KEY=
# Optional: MailerLite group ID to add subscribers to a specific group.
MAILERLITE_GROUP_ID=

# Hostinger email (SMTP) — best-effort notification when someone signs up
# Host/port defaults below match Hostinger's standard SMTP settings; override
# only if your hosting panel shows something different.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=admin@eatyourneighbor.com
SMTP_PASSWORD=
# Optional: where signup notifications are sent. Defaults to SMTP_USER.
NOTIFY_EMAIL=admin@eatyourneighbor.com
